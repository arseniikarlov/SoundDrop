<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fall Ouch!"
            android:textColor="#F7FBFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Выключен"
            android:textColor="#B6C4E3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_open_button"
        android:layout_width="64dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_button_secondary"
        android:gravity="center"
        android:text="Открыть"
        android:textColor="#F7FBFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_toggle_button"
        android:layout_width="58dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button_primary"
        android:gravity="center"
        android:text="Вкл"
        android:textColor="#08111F"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
